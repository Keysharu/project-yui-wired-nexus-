# Copia este archivo como '.env' en esta misma carpeta y añade tus claves
# cuando te concedan los créditos. Este archivo NUNCA se sube a GitHub (.gitignore).

# 1. Meta Model API (Créditos oficiales de 150 $ de Meta)
# Modelo confirmado en el workshop oficial: muse-spark-1.3
# Endpoint: https://api.meta.ai/v1
MODEL_API_KEY=

# 2. Baseten API (Créditos de 100 $ + 2M TPM)
# Modelo objetivo: meta-models/muse-spark-open-1026
BASETEN_API_KEY=

# 3. Modal API (Créditos de 100 $ de GPUs serverless)
MODAL_API_KEY=

# 4. Fireworks API (Créditos de 25 $)
FIREWORKS_API_KEY=

# 5. Servidor Local BMAX (Por defecto ya configurado en red local)
BMAX_HOST=192.168.0.29
BMAX_PORT=11434
BMAX_MODEL=llama3.2:3b
